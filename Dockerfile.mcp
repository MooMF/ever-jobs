FROM node:22-bookworm-slim AS build

WORKDIR /app/apps/mcp

COPY tsconfig.base.json /app/tsconfig.base.json

COPY apps/mcp/package*.json ./
RUN npm install

COPY apps/mcp/tsconfig.json ./
COPY apps/mcp/src ./src

RUN npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app/apps/mcp

ENV NODE_ENV=production
ENV MCP_TRANSPORT=http
ENV PORT=3002
ENV EVER_JOBS_API_URL=http://ever-jobs-api

COPY --from=build /app/apps/mcp/package*.json ./
COPY --from=build /app/apps/mcp/node_modules ./node_modules
COPY --from=build /app/apps/mcp/dist ./dist

EXPOSE 3002

CMD ["node", "dist/index.js"]