FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY nx.json tsconfig*.json nest-cli.json ./
COPY apps ./apps
COPY packages ./packages

# Install root dependencies/devDependencies.
# Do NOT ask npm to treat this as an npm-workspaces build.
RUN npm install \
    --legacy-peer-deps \
    --include=dev \
    --workspaces=false
	
RUN npx playwright install --with-deps chromium

# Confirm the expected Nx version is actually present.
RUN npm ls nx

# Build with the locally installed Nx.
RUN ./node_modules/.bin/nx build api

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV EVER_JOBS_STORE=memory

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/dist ./dist
COPY package*.json ./

RUN echo "=== /app/package.json ===" \
    && head -20 /app/package.json \
    && echo "=== files ===" \
    && ls -la /app

EXPOSE 3001

CMD ["node", "dist/apps/api/main.js"]